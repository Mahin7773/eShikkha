flowchart TD
    subgraph INS["1 · Instructor"]
        direction LR
        A[Create<br/>course] --> B[Add lessons,<br/>materials, quizzes] --> C[Submit for<br/>review]
    end

    subgraph ADM["2 · Administrator"]
        direction LR
        D{Review} -- Approved --> E[Published in<br/>catalogue]
        D -- "Changes /<br/>rejected" --> X[Back to instructor<br/>with feedback]
    end

    subgraph ENR["3 · Student: enrol"]
        direction LR
        F[Browse and<br/>search] --> G{Free?}
        G -- No --> H[Cart and<br/>checkout] --> I{Pay}
        G -- Yes --> J[Enrolled]
        I -- Approved --> J
        I -- Declined --> H
        I -- Cancelled --> F
    end

    subgraph LRN["4 · Student: learn"]
        direction LR
        K[Watch<br/>lessons] --> L[Take<br/>quizzes] --> M{All<br/>done?}
        M -- No --> K
        M -- Yes --> N[Certificate<br/>issued] --> O[Public<br/>verification]
    end

    INS --> ADM
    ADM --> ENR
    ENR --> LRN
