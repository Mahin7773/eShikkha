flowchart TD
    subgraph INS["1 · Instructor"]
        direction LR
        A[Create course] --> B[Add lessons,<br/>materials, quizzes] --> C[Submit for<br/>review]
    end

    subgraph ADM["2 · Administrator"]
        direction LR
        D{Review} -- Approved --> E[Published in<br/>catalogue]
        D -- "Changes /<br/>rejected" --> X[Back to instructor<br/>with feedback]
    end

    subgraph ENR["3 · Student: enrol"]
        direction TB
        F[Browse and search] --> G{Free?}
        G -- No --> H[Cart and checkout] --> I{Payment}
        G -- Yes --> J[Enrolled]
        I -- Approved --> J
        I -- Declined --> H
        I -- Cancelled --> F
    end

    subgraph LRN["4 · Student: learn"]
        direction TB
        K[Watch lessons,<br/>mark complete] --> L[Take quizzes] --> M{All done?}
        M -- No --> K
        M -- Yes --> N[Certificate issued] --> O[Public verification]
    end

    INS --> ADM
    ADM --> ENR
    ENR --> LRN
